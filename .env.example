# Runtime-only value. Never commit a real token.
# DEEPINFRA_TOKEN takes precedence when both are set.
DEEPINFRA_TOKEN=

# Accepted alias for DEEPINFRA_TOKEN (used only when DEEPINFRA_TOKEN is unset).
# DEEPINFRA_API_KEY=

# Optional settings
DEEPINFRA_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731
DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai/chat/completions
HOST=127.0.0.1
PORT=8787

# Optional auth for POST /v1/responses (Bearer token)
RELAY_TOKEN=

# Optional max request body bytes (default 1048576)
MAX_BODY_BYTES=1048576
